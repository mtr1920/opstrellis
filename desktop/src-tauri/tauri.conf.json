{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsTrellis",
  "identifier": "app.opstrellis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpsTrellis",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/sample.wav": "sample.wav"
    },
    "category": "Productivity",
    "shortDescription": "Voice dictation for every app",
    "linux": {
      "deb": {
        "depends": [
          "libxdo3"
        ],
        "files": {
          "/usr/lib/opstrellis/libsherpa-onnx-c-api.so": "target/release/libsherpa-onnx-c-api.so",
          "/usr/lib/opstrellis/libonnxruntime.so": "target/release/libonnxruntime.so"
        }
      },
      "appimage": {
        "files": {
          "/usr/lib/opstrellis/libsherpa-onnx-c-api.so": "target/release/libsherpa-onnx-c-api.so",
          "/usr/lib/opstrellis/libonnxruntime.so": "target/release/libonnxruntime.so"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
