# --- core ---
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opstrellis
# Public origin of this server (used for links, the cookie Secure flag and the CSRF origin check)
PUBLIC_URL=http://localhost:8787
# Number of reverse proxies in front of the server (1 for one); rate limits then use the client IP
# that many entries from the right of X-Forwarded-For. Behind a proxy without this, every client shares
# the proxy's address, so per-IP limits apply to everyone together. Anything but a number or
# true/false stops the server from starting
TRUST_PROXY=0
# Encrypts upstream provider keys saved from the admin UI: use 32+ random characters, e.g.
# `openssl rand -base64 32`, and never change it (saved keys could no longer be read). The server
# refuses to start with this placeholder and warns about a key shorter than 32 characters; left unset,
# saving provider keys in the admin UI is disabled.
MASTER_KEY=change-me-to-a-long-random-string
# The admin account (a valid address; a password of 8 to 200 characters, else the server refuses to
# start). With both set, the server creates it at startup while there is no admin (an existing account
# with this email is promoted: its password becomes ADMIN_PASSWORD, its sessions, API tokens and device
# sign-ins are revoked and it leaves its team); `npm run db:seed` does the same on demand. Changing
# ADMIN_PASSWORD later does nothing once an admin exists; run db:seed to reset it. With ADMIN_EMAIL set
# no signup ever becomes admin. With neither set, the first account on an empty database becomes admin,
# so whoever reaches a fresh server first owns it: set these before exposing the server.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- signup ---
# true/false (also 1/0, yes/no, on/off; anything else stops the server from starting). false makes
# /api/auth/signup answer 403 signup_disabled, except for the first account when it would become admin
ALLOW_SIGNUP=true
# Accounts that may be created in any rolling 24 hours, across all clients (429 signup_limit; default 200).
# Each client IP (IPv6: /64) may also create at most 20 accounts a day.
MAX_SIGNUPS_PER_DAY=200

# --- billing limits ---
# Pro overage minutes allowed per billing period (402 overage_cap_reached; default 3000; 0 = no overage)
MAX_OVERAGE_MINUTES=3000

# --- self-hosted model (provider "local") ---
# Directory containing model folders; a catalog entry's upstream_model is the folder name
LOCAL_MODEL_DIR=models
LOCAL_NUM_THREADS=2

# --- upstream provider keys (used when none is saved in the admin UI) ---
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Optional base URL overrides (<PROVIDER>_BASE_URL), e.g. a self-hosted OpenAI-compatible server
# OPENAI_BASE_URL=http://localhost:8000/v1

# --- Stripe (leave STRIPE_SECRET_KEY empty for manual billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring $12/month price for Pro. When set, only a subscription containing this price is Pro
# (changing it later drops existing subscribers to Free at their next subscription event)
STRIPE_PRICE_PRO=
# Metered price attached to the Billing Meter below ($0.02 per unit = minute)
STRIPE_PRICE_OVERAGE=
STRIPE_METER_EVENT=opstrellis_managed_minutes

# Node fetch behind an HTTP(S) proxy
# NODE_USE_ENV_PROXY=1
